// DELETE /aula/:id
app.delete("/aula/:id", async (req, res) => {
  try {
    const id = req.params.id
    await db.pool.query("DELETE FROM aula WHERE id = ?", [id])
    res.status(200).json({ resultado: "Aula deletada com sucesso" })
  } catch (erro) {
    res.status(500).json({ erro: erro.message })
  }
})

// POST /horario
app.post("/horario", async (req, res) => {
  try {
    const dados = req.body
    const resultado = await db.pool.query(
      "INSERT INTO horario (dia, hora, componente, professor) VALUES (?, ?, ?, ?)",
      [dados.dia, dados.hora, dados.componente, dados.professor]
    )
    res.status(201).json(
      { resultado: "Horário cadastrado, ID = " + resultado[0].insertId }
    )
  } catch (erro) {
    res.status(500).json({ erro: erro.message })
  }
})

// GET /horario/:dia
app.get("/horario/:dia", async (req, res) => {
  try {
    const dia = req.params.dia
    const resultado = await db.pool.query(
      "SELECT * FROM horario WHERE dia = ?",
      [dia]
    )
    res.status(200).json(resultado[0])
  } catch (erro) {
    res.status(500).json({ erro: erro.message })
  }
})

